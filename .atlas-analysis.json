  "keyFeatures": [
    "Transactional email sending via REST API or SMTP",
    "Bulk marketing email campaigns with contact list targeting",
    "A/B testing for campaign emails",
    "Personalized batch SMS with template support",
    "Contact and contact list management",
    "Real-time webhook event notifications (delivered, opened, clicked, bounced, etc.)",
    "Email open and click tracking",
    "Sandbox mode for safe testing",
    "OAuth 2.0 and API Key authentication",
    "Scheduled future sending (up to 72 hours ahead for transactional, 30 days for A/B tests)",
    "SMTP extensions via X-Easeye headers",
    "Verified sender domain management"
  ],
